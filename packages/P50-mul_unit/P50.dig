<?xml version="1.0" encoding="utf-8"?>
<circuit>
  <version>1</version>
  <attributes/>
  <visualElements>
    <!-- Original Input & Output Pins -->
    <visualElement>
      <elementName>Clock</elementName>
      <elementAttributes>
        <entry><string>Label</string><string>clk</string></entry>
        <entry><string>Frequency</string><int>1</int></entry>
      </elementAttributes>
      <pos x="100" y="100"/>
    </visualElement>
    <visualElement>
      <elementName>In</elementName>
      <elementAttributes>
        <entry><string>Label</string><string>rst</string></entry>
        <entry><string>Bits</string><int>1</int></entry>
      </elementAttributes>
      <pos x="100" y="160"/>
    </visualElement>
    <visualElement>
      <elementName>In</elementName>
      <elementAttributes>
        <entry><string>Label</string><string>start</string></entry>
        <entry><string>Bits</string><int>1</int></entry>
      </elementAttributes>
      <pos x="100" y="220"/>
    </visualElement>
    <visualElement>
      <elementName>In</elementName>
      <elementAttributes>
        <entry><string>Label</string><string>a</string></entry>
        <entry><string>Bits</string><int>4</int></entry>
      </elementAttributes>
      <pos x="100" y="280"/>
    </visualElement>
    <visualElement>
      <elementName>In</elementName>
      <elementAttributes>
        <entry><string>Label</string><string>b</string></entry>
        <entry><string>Bits</string><int>4</int></entry>
      </elementAttributes>
      <pos x="100" y="340"/>
    </visualElement>
    <visualElement>
      <elementName>Out</elementName>
      <elementAttributes>
        <entry><string>Label</string><string>result</string></entry>
        <entry><string>Bits</string><int>8</int></entry>
      </elementAttributes>
      <pos x="900" y="100"/>
    </visualElement>
    <visualElement>
      <elementName>Out</elementName>
      <elementAttributes>
        <entry><string>Label</string><string>busy</string></entry>
        <entry><string>Bits</string><int>1</int></entry>
      </elementAttributes>
      <pos x="900" y="160"/>
    </visualElement>

    <!-- Tunnels for Inputs/Outputs -->
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>clk</string></entry></elementAttributes>
      <pos x="140" y="100"/>
    </visualElement>
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>rst</string></entry></elementAttributes>
      <pos x="140" y="160"/>
    </visualElement>
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>start</string></entry></elementAttributes>
      <pos x="140" y="220"/>
    </visualElement>
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>a</string></entry></elementAttributes>
      <pos x="140" y="280"/>
    </visualElement>
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>b</string></entry></elementAttributes>
      <pos x="140" y="340"/>
    </visualElement>
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>res</string></entry></elementAttributes>
      <pos x="860" y="100"/>
    </visualElement>
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>busy</string></entry></elementAttributes>
      <pos x="860" y="160"/>
    </visualElement>

    <!-- ================= CONTROL UNIT (3-bit Counter) ================= -->
    <visualElement>
      <elementName>Const</elementName>
      <elementAttributes><entry><string>Value</string><long>0</long></entry><entry><string>Bits</string><int>3</int></entry></elementAttributes>
      <pos x="260" y="540"/>
    </visualElement>
    <visualElement>
      <elementName>Const</elementName>
      <elementAttributes><entry><string>Value</string><long>1</long></entry><entry><string>Bits</string><int>3</int></entry></elementAttributes>
      <pos x="260" y="580"/>
    </visualElement>
    <visualElement>
      <elementName>Multiplexer</elementName>
      <elementAttributes><entry><string>Bits</string><int>3</int></entry></elementAttributes>
      <pos x="300" y="540"/>
    </visualElement>
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>start</string></entry></elementAttributes>
      <pos x="320" y="600"/>
    </visualElement>

    <!-- Mux for done (cnt == 4 ? 0 : cnt+1) -->
    <visualElement>
      <elementName>Const</elementName>
      <elementAttributes><entry><string>Value</string><long>0</long></entry><entry><string>Bits</string><int>3</int></entry></elementAttributes>
      <pos x="260" y="680"/>
    </visualElement>
    <visualElement>
      <elementName>Multiplexer</elementName>
      <elementAttributes><entry><string>Bits</string><int>3</int></entry></elementAttributes>
      <pos x="300" y="640"/>
    </visualElement>
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>done</string></entry></elementAttributes>
      <pos x="320" y="700"/>
    </visualElement>

    <!-- Mux for busy (busy ? next_running : next_idle) -->
    <visualElement>
      <elementName>Multiplexer</elementName>
      <elementAttributes><entry><string>Bits</string><int>3</int></entry></elementAttributes>
      <pos x="400" y="580"/>
    </visualElement>
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>busy</string></entry></elementAttributes>
      <pos x="420" y="640"/>
    </visualElement>

    <!-- Mux for rst (rst ? 0 : next_cnt) -->
    <visualElement>
      <elementName>Const</elementName>
      <elementAttributes><entry><string>Value</string><long>0</long></entry><entry><string>Bits</string><int>3</int></entry></elementAttributes>
      <pos x="460" y="640"/>
    </visualElement>
    <visualElement>
      <elementName>Multiplexer</elementName>
      <elementAttributes><entry><string>Bits</string><int>3</int></entry></elementAttributes>
      <pos x="500" y="600"/>
    </visualElement>
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>rst</string></entry></elementAttributes>
      <pos x="520" y="660"/>
    </visualElement>

    <!-- CNT Register -->
    <visualElement>
      <elementName>Register</elementName>
      <elementAttributes><entry><string>Bits</string><int>3</int></entry></elementAttributes>
      <pos x="600" y="600"/>
    </visualElement>
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>clk</string></entry></elementAttributes>
      <pos x="580" y="620"/>
    </visualElement>
    <visualElement>
      <elementName>Const</elementName>
      <elementAttributes><entry><string>Value</string><long>1</long></entry></elementAttributes>
      <pos x="580" y="640"/>
    </visualElement>

    <!-- CNT + 1 Adder -->
    <visualElement>
      <elementName>Add</elementName>
      <elementAttributes><entry><string>Bits</string><int>3</int></entry></elementAttributes>
      <pos x="720" y="540"/>
    </visualElement>
    <visualElement>
      <elementName>Const</elementName>
      <elementAttributes><entry><string>Value</string><long>1</long></entry><entry><string>Bits</string><int>3</int></entry></elementAttributes>
      <pos x="700" y="560"/>
    </visualElement>
    <visualElement>
      <elementName>Const</elementName>
      <elementAttributes><entry><string>Value</string><long>0</long></entry></elementAttributes>
      <pos x="700" y="580"/>
    </visualElement>

    <!-- CNT == 0 Comparator (for busy) -->
    <visualElement>
      <elementName>Comparator</elementName>
      <elementAttributes><entry><string>Bits</string><int>3</int></entry></elementAttributes>
      <pos x="720" y="640"/>
    </visualElement>
    <visualElement>
      <elementName>Const</elementName>
      <elementAttributes><entry><string>Value</string><long>0</long></entry><entry><string>Bits</string><int>3</int></entry></elementAttributes>
      <pos x="700" y="660"/>
    </visualElement>
    <visualElement>
      <elementName>Not</elementName>
      <elementAttributes/>
      <pos x="800" y="660"/>
    </visualElement>
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>busy</string></entry></elementAttributes>
      <pos x="860" y="660"/>
    </visualElement>

    <!-- CNT == 4 Comparator (for done) -->
    <visualElement>
      <elementName>Comparator</elementName>
      <elementAttributes><entry><string>Bits</string><int>3</int></entry></elementAttributes>
      <pos x="720" y="720"/>
    </visualElement>
    <visualElement>
      <elementName>Const</elementName>
      <elementAttributes><entry><string>Value</string><long>4</long></entry><entry><string>Bits</string><int>3</int></entry></elementAttributes>
      <pos x="700" y="740"/>
    </visualElement>
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>done</string></entry></elementAttributes>
      <pos x="800" y="740"/>
    </visualElement>

    <!-- LOAD Signal: load = (~busy) & start -->
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>busy</string></entry></elementAttributes>
      <pos x="220" y="780"/>
    </visualElement>
    <visualElement>
      <elementName>Not</elementName>
      <elementAttributes/>
      <pos x="260" y="780"/>
    </visualElement>
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>start</string></entry></elementAttributes>
      <pos x="260" y="820"/>
    </visualElement>
    <visualElement>
      <elementName>And</elementName>
      <elementAttributes/>
      <pos x="320" y="780"/>
    </visualElement>
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>load</string></entry></elementAttributes>
      <pos x="400" y="800"/>
    </visualElement>

    <!-- ================= DATAPATH: REG_B (4-bit Shift Right) ================= -->
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>b</string></entry></elementAttributes>
      <pos x="300" y="960"/>
    </visualElement>
    <visualElement>
      <elementName>Multiplexer</elementName>
      <elementAttributes><entry><string>Bits</string><int>4</int></entry></elementAttributes>
      <pos x="340" y="920"/>
